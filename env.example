DB_HOST=localhost
DB_NAME=XXXX
DB_PORT=5432
DB_USERNAME=XXX
DB_PASSWORD=XXX

GEMINI_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT=3m
EXTERNAL_CALL_TIMEOUT=90s

#BACKEND URL
#VITE_API_URL=http://renato-svr-01:9090

#FRONTEND URL
CORS_ALLOWED_ORIGIN=http://localhost:5173

FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json

# Optional durable-classification worker tuning
# CLASSIFICATION_BATCH_SIZE=50
# CLASSIFICATION_PROPAGATION_BATCH_SIZE=50
# CLASSIFICATION_MAX_AI_ATTEMPTS=3
# CLASSIFICATION_MAX_APPLY_ATTEMPTS=3
# CLASSIFICATION_LEASE_DURATION=10m
# CLASSIFICATION_RETRY_DELAYS=1m,5m,15m
# CLASSIFICATION_CATALOG_REGISTRATION_CRON=0 * * * * *
# CLASSIFICATION_BATCH_CREATION_CRON=10 * * * * *
# CLASSIFICATION_AI_CRON=0 */5 * * * *
# CLASSIFICATION_AI_RECOVERY_CRON=20 * * * * *
# CLASSIFICATION_APPLY_CRON=30 * * * * *
# CLASSIFICATION_APPLY_RECOVERY_CRON=40 * * * * *
# CLASSIFICATION_PROPAGATION_CRON=45 * * * * *
# SCHEDULER_POOL_SIZE=4

# Gmail SMTP delivery. Use the full Gmail address and a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=replace-with-16-character-google-app-password
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
# Optional timeout overrides (milliseconds; defaults are 90 seconds)
# SMTP_CONNECTION_TIMEOUT_MS=90000
# SMTP_READ_TIMEOUT_MS=90000
# SMTP_WRITE_TIMEOUT_MS=90000
# ADMIN_EMAIL_FROM defaults to SMTP_USERNAME. Set it only to a Gmail alias
# configured for this account.
# ADMIN_EMAIL_FROM=your-configured-alias@example.com
ADMIN_EMAIL_RECIPIENTS=your-account@gmail.com
ADMIN_EMAIL_API_KEY=replace-with-a-long-random-secret
